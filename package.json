{
  "name": "flomo-cli-mcp-fronted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "flomo 的 MCP 服务器（stdio）：进程内直连 flomo 能力层，向 agent 暴露 flomo_* 工具",
  "bin": {
    "flomo-cli-mcp-fronted": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "sync:core": "tsx scripts/sync-core.ts",
    "check:core": "tsx scripts/sync-core.ts --check",
    "test": "vitest run",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "self-test": "tsx src/index.ts --self-test",
    "list-tools": "tsx src/index.ts --list-tools"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
